ROLL_SCALE_API_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/ingest-measurement
ROLL_SCALE_LOOKUP_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/lookup-roll
ROLL_SCALE_DEVICE_TOKEN=replace-with-device-ingest-token
ROLL_SCALE_LOOKUP_TOKEN=replace-with-device-lookup-token
ROLL_SCALE_GATEWAY_ID=gateway-01
ROLL_SCALE_DEVICE_ID=gateway-01
# Render Pro: trỏ vào Persistent Disk để evidence không mất khi restart.
# ROLL_SCALE_DATA_ROOT=/var/data
ROLL_SCALE_LOCAL_RETENTION_DAYS=7
ROLL_SCALE_STATION_COUNT=2
ROLL_SCALE_STATION_IDS=station-01,station-02
ROLL_SCALE_CAMERA_IDS=camera-01,camera-02
ROLL_SCALE_MACHINE_IDS=Máy tái chế,Máy cách nhiệt

# Optional: list remote rows in the UI. Without these, the UI lists local SQLite.
# ROLL_SCALE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# ROLL_SCALE_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-anon-or-publishable-key
# ROLL_SCALE_SUPABASE_SERVICE_KEY=replace-with-service-role-key-only-on-trusted-hosts

# Bảng chính lệnh SX (thường là Supabase khác project ingest-measurement).
# ROLL_SCALE_PRODUCTION_ORDER_SUPABASE_URL=https://YOUR_LSX_PROJECT_REF.supabase.co
# ROLL_SCALE_PRODUCTION_ORDER_SUPABASE_SERVICE_KEY=replace-with-service-role-key
# ROLL_SCALE_PRODUCTION_ORDER_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# ROLL_SCALE_PRODUCTION_ORDER_TABLE=lenh_san_xuat

# Optional cloud recognition. The browser compresses one evidence image per
# capture; the backend crops the configured/detected LED region before Gemini.
# Product codes are accepted from dedicated QR decoders, not inferred by Gemini.
ROLL_SCALE_GEMINI_ENABLED=false
ROLL_SCALE_WEIGHT_ENGINE=local
# ROLL_SCALE_GEMINI_API_KEY=replace-with-google-ai-studio-key
# Key ca đêm (12C2) được nhập tại Cài đặt → Key ca đêm và lưu mã hóa
# riêng trong Supabase. 12C1 luôn dùng key môi trường/key ca ngày ở trên.
ROLL_SCALE_GEMINI_MODEL=gemini-3.5-flash-lite
ROLL_SCALE_GEMINI_TIMEOUT=10.0
ROLL_SCALE_GEMINI_31_MODEL=gemini-3.1-flash-lite
ROLL_SCALE_GEMINI_31_TIMEOUT=15.0
ROLL_SCALE_GEMINI_37_MODEL=gemini-3.7-flash
ROLL_SCALE_GEMINI_37_TIMEOUT=30.0
ROLL_SCALE_GEMINI_ACCURATE_MODEL=gemini-3.1-pro-preview
ROLL_SCALE_GEMINI_ACCURATE_TIMEOUT=30.0
# Optional stable Fernet key for the Gemini key saved from the web UI. When
# blank, it derives from DEVICE_TOKEN; rotating DEVICE_TOKEN then requires
# entering the Gemini key again.
# ROLL_SCALE_GEMINI_KEY_ENCRYPTION_KEY=replace-with-a-fernet-key

# Optional ChatGPT/Codex alternative. Gemini API remains available in the UI.
# `auto` uses device-code OAuth on Render and the installed Codex CLI locally.
ROLL_SCALE_CODEX_ENABLED=true
ROLL_SCALE_CODEX_MODE=auto
ROLL_SCALE_CODEX_COMMAND=codex
# OAuth mode defaults to gpt-5.5; CLI mode uses the account default when blank.
ROLL_SCALE_CODEX_MODEL=
ROLL_SCALE_CODEX_TIMEOUT=60.0
# Optional stable Fernet key. When blank, the app derives it from DEVICE_TOKEN;
# rotating DEVICE_TOKEN then requires logging into Codex again.
# ROLL_SCALE_CODEX_TOKEN_KEY=replace-with-a-fernet-key

# ROLL_SCALE_DEVICE_ID is the legacy compatibility name for gateway_id.
# Browser media device IDs stay local and are never cloud identities.

# These values belong only in Supabase Edge Function secrets.
# Never put production Cloudinary credentials in the desktop environment.
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
