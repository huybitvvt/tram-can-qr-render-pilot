# Choose exactly one source. A USB index is shown; replace with an RTSP URL for a wireless camera.
CAMERA_SOURCE=0
# CAMERA_SOURCE=rtsp://user:password@192.168.1.50:554/stream1
# Windows OBS Virtual Camera: DSHOW. Other choices include MSMF or AUTO.
CAMERA_BACKEND=AUTO
FRAME_WIDTH=1280
FRAME_HEIGHT=720
CAMERA_FPS=30
CAMERA_RECONNECT_SECONDS=2
RTSP_TRANSPORT=tcp

# Supports model_1 (0-9, optional none) or model_2 (-, ., 0-9).
MODEL_PATH=backend/model/best.pt
DETECTION_CONFIDENCE=0.25
DISPLAY_COLORS=red
DISPLAY_MAX_CANDIDATES=5
DISPLAY_IMAGE_SIZE=640
# Print every crop and raw prediction when troubleshooting.
DETECTION_DEBUG=false
INFERENCE_CONFIDENCE=0.70
INFERENCE_FPS=7
REQUIRED_STABLE_FRAMES=3
# Implied decimal places for both models; model_2's dot class is ignored.
DECIMAL_PLACES=2
SNAPSHOT_MAX_AGE_SECONDS=3

# Choose csv for a spreadsheet-readable file, or sqlite for the local database.
STORAGE_ENABLE=false
STORAGE_TYPE=csv
CSV_PATH=backend/data/measurements.csv
DATABASE_PATH=backend/data/measurements.db
DUPLICATE_WINDOW_SECONDS=60

HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173
JPEG_QUALITY=80
STREAM_FPS=20
