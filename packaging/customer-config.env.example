# Sao chép file này thành:
# %LOCALAPPDATA%\TramCanQR\config.env
#
# Không đưa CLOUDINARY_API_SECRET hoặc Supabase service-role key vào máy trạm.

# Khuyến nghị triển khai độc lập: mỗi máy chỉ chạy đúng 1 trạm. Máy 02-04
# phải đổi đồng thời hậu tố của GATEWAY_ID, STATION_IDS và CAMERA_IDS.
ROLL_SCALE_STATION_COUNT=1
ROLL_SCALE_GATEWAY_ID=gateway-01
ROLL_SCALE_LOCAL_RETENTION_DAYS=7
# Có thể đổi sang ổ đĩa nội bộ bền vững của máy vận hành.
# ROLL_SCALE_DATA_ROOT=%LOCALAPPDATA%\TramCanQR\data
ROLL_SCALE_STATION_IDS=station-01
ROLL_SCALE_CAMERA_IDS=camera-01
# Optional: chỉ dùng nếu từng camera cố định vĩnh viễn vào một loại máy sản xuất.
# ROLL_SCALE_CAMERA_MACHINE_IDS=Máy tái chế,Máy cách nhiệt,Máy Bao Bì

# Giữ các giá trị đã được kiểm thử. Chỉ đổi khi có biên bản hiệu chỉnh mới.
ROLL_SCALE_PORT=8080
ROLL_SCALE_YOLO_IMGSZ=960
ROLL_SCALE_OCR_MIN_CONFIDENCE=0.60
ROLL_SCALE_WEIGHT_BURST_FRAMES=5

# Gemini là nhận dạng cloud tùy chọn. Trình duyệt gửi một ảnh bằng chứng đã nén;
# backend crop vùng LED trước khi gọi Gemini. Mã SP do QR decoder chuyên dụng đọc.
ROLL_SCALE_GEMINI_ENABLED=false
ROLL_SCALE_WEIGHT_ENGINE=local
# ROLL_SCALE_GEMINI_API_KEY=replace-with-key-for-this-station
# Tùy chọn key thứ hai; backend chuyển sang key này khi key chính lỗi API và
# quarantine key lỗi cho tới khi khởi động lại hoặc lưu key mới.
# ROLL_SCALE_GEMINI_BACKUP_API_KEY=replace-with-second-key-for-this-station
ROLL_SCALE_GEMINI_MODEL=gemini-3.5-flash-lite
ROLL_SCALE_GEMINI_ACCURATE_MODEL=gemini-3.1-pro-preview
ROLL_SCALE_GEMINI_ACCURATE_TIMEOUT=30.0
ROLL_SCALE_GEMINI_TIMEOUT=30.0
# Ngưỡng hiển thị quota cục bộ; chỉnh theo model/project thực tế.
# ROLL_SCALE_GEMINI_RPM_LIMIT=15
# ROLL_SCALE_GEMINI_TPM_LIMIT=250000
# ROLL_SCALE_GEMINI_RPD_LIMIT=500

# Optional Antigravity Google-account/API-key provider (requires local `agy` or
# the optional google-antigravity SDK; it is not used by the default local OCR).
# ROLL_SCALE_ANTIGRAVITY_COMMAND=agy
# ROLL_SCALE_ANTIGRAVITY_MODEL=gemini-3.5-flash-low
# ROLL_SCALE_ANTIGRAVITY_ROTATE_IMAGE_TURNS=20
# ROLL_SCALE_ANTIGRAVITY_API_KEY=separate-gemini-key-for-antigravity-sdk

# Khuyến nghị sau khi lắp camera cố định: ROI hàng gross cho từng trạm theo
# x1,y1,x2,y2 (0..1), các trạm ngăn cách bằng dấu chấm phẩy. Không cấu hình
# thì phần mềm vẫn tự dò LED nhưng tốc độ/độ ổn định kém hơn ROI cố định.
# ROLL_SCALE_WEIGHT_ROIS=0.4500,0.8000,0.5400,0.8500

# Bỏ dấu # và thay đúng bộ Supabase riêng được cấp cho trạm này để bật đồng bộ
# cloud. Phải cấu hình đủ cả URL và token của từng API; không sao chép bộ này
# sang trạm khác.
# ROLL_SCALE_API_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/ingest-measurement
# ROLL_SCALE_DEVICE_TOKEN=replace-with-device-ingest-token
# ROLL_SCALE_LOOKUP_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/lookup-roll
# ROLL_SCALE_LOOKUP_TOKEN=replace-with-device-lookup-token
# ROLL_SCALE_SYNC_TIMEOUT=120
